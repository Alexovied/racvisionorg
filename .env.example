# Copiá este archivo a .env (que está en .gitignore) y completá los valores.
# Nunca subas valores reales al repositorio.

# Admin inicial: solo se usa si data/users.json no existe o está vacío.
# Si ADMIN_PASSWORD queda vacío, se genera una contraseña aleatoria y se muestra una vez en consola.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Clave de sesión de Flask. Conviene definirla si data/ no es un volumen persistente
# (si no, data/.secret_key se pierde en cada deploy). Vacía, se genera sola y se guarda en data/.secret_key.
# Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Depurador de Werkzeug: "1" solo en desarrollo local. Nunca en un servidor expuesto.
FLASK_DEBUG=0

# Puerto para `python src/app.py` en local.
PORT=5000

# Cuántos proxies hay delante de la app (nginx/Caddy que termina HTTPS = 1; con Cloudflare delante = 2).
# Hace que el bloqueo de login cuente por IP real del visitante. Sin proxy, dejalo vacío.
PROXIES=

# ESP32 por USB serie (solo en local). Si no está conectado, el sistema sigue funcionando.
SERIAL_PORT=COM4
SERIAL_BAUD=115200

# Webhook de n8n para alertas sin casco (opcional).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# ── Opcionales: descomentá solo las que uses (las que tienen valor muestran el valor por defecto) ──

# Zona horaria del contenedor (por defecto UTC): el horario de cada cámara y REPORTE_HORA usan la hora local.
# TZ=America/Argentina/Buenos_Aires

# Cifra data/personas.json (embeddings de caras) en reposo. RESPALDALA fuera del servidor: si se pierde
# o cambia, el archivo no se puede abrir y nadie se reconoce. Generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RAC_CLAVE_BIOMETRIA=

# OpenVINO. En un contenedor con CPU limitada (docker cpus: 1.5) poné en OPENVINO_HILOS los núcleos
# enteros del límite: si no, abre un hilo por núcleo del equipo y el servidor se congela.
# OPENVINO_HILOS=
# OPENVINO_DEVICE=CPU

# Avisos por Telegram (hacen falta las dos). REPORTE_HORA (0 a 23) manda el reporte de ayer a esa hora.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# REPORTE_HORA=

# Eventos por MQTT (SCADA, PLC, Node-RED). Sin MQTT_HOST no hace nada. Puerto 8883 con MQTT_TLS=1.
# MQTT_HOST=
# MQTT_PORT=1883
# MQTT_TLS=
# MQTT_USER=
# MQTT_PASS=
# MQTT_TOPIC=rac/eventos

# Reporte redactado con IA: alcanza con una de las dos claves. GEMINI_MODEL cambia el modelo de Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=

# Correo del SGEP. Sin SMTP_HOST los mensajes solo se registran (modo demo).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Solo para herramientas/: token de la cámara en relay_camara.py y clave del admin de prueba en benchmark_carga.py.
# RAC_TOKEN=
# RAC_BENCH_PASSWORD=
