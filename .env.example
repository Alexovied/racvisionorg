# Copiá este archivo a .env (que está en .gitignore) y completá los valores.
# Nunca subas valores reales al repositorio.

# Admin inicial: solo se usa si data/users.json no existe o está vacío.
# Si ADMIN_PASSWORD queda vacío, se genera una contraseña aleatoria y se muestra una vez en consola.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<cambiar-por-una-contraseña-larga>

# Clave de sesión de Flask. En Render conviene definirla (el disco es efímero y
# data/.secret_key se pierde en cada deploy). Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<clave-aleatoria-de-64-caracteres-hex>

# Depurador de Werkzeug: "1" solo en desarrollo local. Nunca en un servidor expuesto.
FLASK_DEBUG=0

# Puerto para `python app.py` (Render lo define solo).
PORT=5000

# ESP32 por USB serie (solo en local). Si no está conectado, el sistema sigue funcionando.
SERIAL_PORT=COM4
SERIAL_BAUD=115200

# Webhook de n8n para alertas sin casco (opcional).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
